# sent_id = job39.18.1
# text = Ἦ δ' ὅτε ἀμφιποτᾶται ἐν αἰθέρι καὶ νεφέλῃσιν, Ἧτ' ἄλλων θέμις ἐστὶν ὑπερανίων πετεινῶν, Ὑψι δ' λαχνῆέν τε κάρη καὶ στήθε' ἄειρεν Ἴσον ὅπως, πτέρυγας λαῖφ' ἱστία δ' ὡς πετάσασα Ῥίμφα θέει διὰ γαῖαν ἅμα πνοιῇς ἀνέμοιο, Ὁίᾴ τις αὐτομάτη πεζὴ νηῦς, τῇ ἄρα μοῦνοι Ἔκκλυτοι ἔργων ὄπισθε κυβερνητῆρες ἔασιν·
# source_parser = pyaegean grc-joint-v3
