itted" unit="line" quantity="8" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1505-1512"/><milestone unit="card" n="1513" resp="Smyth"/><gap reason="omitted" unit="line" quantity="8" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1513-1520"/><milestone unit="card" n="1521" resp="Smyth"/><gap reason="omitted" unit="line" quantity="9" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1521-1529"/><milestone unit="card" n="1530" resp="Smyth"/><gap reason="omitted" unit="line" quantity="7" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1530-1536"/><milestone unit="card" n="1537" resp="Smyth"/><gap reason="omitted" unit="line" quantity="14" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1537-1550"/><milestone unit="card" n="1551" resp="Smyth"/><gap reason="omitted" unit="line" quantity="9" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1551-1559"/><milestone unit="card" n="1560" resp="Smyth"/><gap reason="omitted" unit="line" quantity="7" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1560-1566"/><milestone unit="card" n="1567" resp="Smyth"/><gap reason="omitted" unit="line" quantity="10" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1567-1576"/><milestone unit="card" n="1577" resp="Smyth"/><gap reason="omitted" unit="line" quantity="40" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1577-1616"/><milestone unit="card" n="1617" resp="Smyth"/><gap reason="omitted" unit="line" quantity="32" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1617-1648"/><milestone unit="card" n="1649" resp="Smyth"/><gap reason="omitted" unit="line" quantity="25" corresp="urn:cts:greekLit:tlg0085.tlg005.perseus-grc2:1649-1673"/></lg>
