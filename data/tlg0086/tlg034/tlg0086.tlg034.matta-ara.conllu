# sent_id = 25.19
# document_id = 0086-034
# text_lang = ara
# subdoc = 25.19
# translation_lang = en
# text = واما اسم الحياة فيقسم وافادقلس ايضا يقول انه كانوا الذين لم يزالوا غير ماٮتـ** منذ قط ينشون من ساعتهم مايتين واما الحياة فالتى خلقت لهم قديما
