# document_id = 0086-034
# text_lang = ara
# subdoc = 6.4
# translation_lang = en
# text = واما لهذا ڡٮحعلٮـ ان تستتم الاجزا من غير الانواع التى بسبب الاوزان وايضا عند ما يعدون اخر التى تكون بالصوت والنغمة
