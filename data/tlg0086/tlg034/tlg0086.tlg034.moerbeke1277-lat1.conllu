# sentence_id = 370
# document_id = 0086-034-lat
# subdoc = 26.5
# translation_lang = en
# prose_translation = Epic poetry, they say, is addressed to refined viewers who do not need gestures, whereas tragedy is addressed to vulgar ones; if, then, it is vulgar, it is clearly inferior.
