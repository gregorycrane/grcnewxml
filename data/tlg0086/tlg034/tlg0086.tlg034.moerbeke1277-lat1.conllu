# sentence_id = 100
# document_id = 0086-034-lat
# subdoc = 8.1
# translation_lang = en
# prose_translation = A plot is not unified, as some think, if it revolves around one person; for many, indeed infinite, things happen to a single individual, out of which no single unity arises.
# literal_translation = Plot moreover is one not, just-as certain think, if around one it-be; many for and infinite in-kind happen, out-of which some-things no-one is one.
