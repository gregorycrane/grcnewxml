# sentence_id = 109
# document_id = 0086-034-lat
# subdoc = 9.6
# translation_lang = en
# prose_translation = In tragedy, however, they stick to traditional names. The reason is that what is possible is persuasive: things that have not happened we do not yet believe to be possible, but what has happened is obviously possible, for it would not have happened if it were impossible.
# literal_translation = In tragedy moreover made names hold-to; cause moreover because probable is which possible. Non done-things indeed therefore not-yet we-believe to-be possible, done-things moreover manifest which possible; non for certainly done-things would-be if were impossible.
